# All values are optional for local development.
# With none of them set, ReconAI runs on a JSON-backed local store and a
# deterministic local embedder.

# Supabase / Postgres (pgvector) — enables the Supabase-backed store
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Org used for unauthenticated local requests
RECON_DEV_ORG_ID=demo-org

# FastAPI embedding service
RECON_EMBEDDING_SERVICE_URL=http://localhost:8000
RECON_EMBEDDING_SERVICE_KEY=

# Upstash rate limiting (no-op locally when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
